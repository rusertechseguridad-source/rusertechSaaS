model Telemetry {
  id              String                    @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenant_id       String                    @db.Uuid
  vehicle_id      String                    @db.Uuid
  avl_user_id     String                    @db.Uuid
  timestamp       DateTime                  @db.Timestamptz(6)
  latitude        Float
  longitude       Float
  odometer_km     Float?
  speed_kmh       Float?                    @db.Real
  altitude_meters Float?                    @db.Real
  battery_pct     Float?                    @db.Real
  temperature_c   Float?                    @db.Real
  humidity_pct    Float?                    @db.Real
  heading_degrees Int?                      @db.SmallInt
  ignition        Boolean?
  is_duplicate    Boolean                   @default(false)
  direction_label String?                   @db.VarChar(10)
  provider_code   String?                   @db.VarChar(50)
  event_type      String?                   @db.VarChar(100)
  location        Unsupported("geography")?
  raw_payload     Json

  @@id([id, timestamp])
  @@index([location], map: "idx_telemetry_location", type: Gist)
  @@index([tenant_id, timestamp(sort: Desc)], map: "idx_telemetry_tenant_time")
  @@index([vehicle_id, timestamp(sort: Desc)], map: "idx_telemetry_vehicle_time")
  @@map("telemetry")
}

model Geofence {
