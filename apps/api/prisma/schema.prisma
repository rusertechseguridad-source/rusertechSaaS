  trip_conditions           trip_conditions[]
  linked_to_trips           TripLinkedVehicle[]
  trips                     Trip[]
  user_access               UserVehicleAccess[]
  vehicle_geofence_state    vehicle_geofence_state[]
  avl_user                  AvlUser?                 @relation(fields: [avl_user_id], references: [id])
  carrier                   Carrier?                 @relation(fields: [carrier_id], references: [id])
  group                     VehicleGroup?            @relation(fields: [group_id], references: [id])
  tenant                    Tenant                   @relation(fields: [tenant_id], references: [id])

  @@unique([tenant_id, plate])
  @@map("vehicles")
}

