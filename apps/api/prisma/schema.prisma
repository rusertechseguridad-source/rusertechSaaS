  fuel_efficiency_lper100km Decimal?                 @db.Decimal(6, 2)
  hub_asset_id              String?                  @db.VarChar(100)
  avl_user_id               String?                  @db.Uuid
  is_blocked                Boolean                  @default(false)
  block_reason              String?
  metadata_json             Json                     @default("{}")
  status                    String                   @default("active") @db.VarChar(20)
  created_at                DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at                DateTime                 @default(now()) @db.Timestamptz(6)
  dictionary_category       String?                  @db.VarChar(100)
  carrier_id                String?                  @db.Uuid
  image_front_url           String?                  @db.VarChar(500)
  image_rear_url            String?                  @db.VarChar(500)
  image_side_url            String?                  @db.VarChar(500)
  group_id                  String?                  @db.Uuid
