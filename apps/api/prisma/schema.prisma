model Tenant {
  id                       String                    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name                     String                    @db.VarChar(200)
  slug                     String                    @unique @db.VarChar(100)
  plan                     String                    @default("starter") @db.VarChar(50)
  status                   String                    @default("active") @db.VarChar(20)
  settings_json            Json                      @default("{}")
  created_at               DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at               DateTime                  @default(now()) @db.Timestamptz(6)
  avl_users                AvlUser[]
  carbon_logs              CarbonLog[]
  carbon_settings          CarbonSetting?
  carriers                 Carrier[]
  control_zones            ControlZone[]
  devices                  Device[]
  drivers                  Driver[]
  event_logs               EventLog[]
  event_rules              EventRule[]
  geofences                Geofence[]
  mobileActivationCodes    MobileActivationCode[]
  mobile_alert_channels    mobile_alert_channels[]
  motor_estado_vehiculo    motor_estado_vehiculo[]
  motor_niveles_riesgo     motor_niveles_riesgo[]
  motor_vehiculos_activos  motor_vehiculos_activos[]
  no_signal_zones          NoSignalZone[]
  notification_channels    NotificationChannel[]
  operational_protocols    OperationalProtocol[]
  operations               Operation[]
  parameter_settings       ParameterSetting[]
  position_forwarders      PositionForwarder[]
  routes                   Route[]
  saved_locations          SavedLocation[]
  security_keys            SecurityKey[]
  sensor_configs           SensorConfig[]
  tenant_engine_config     tenant_engine_config?
  tenant_mobile_config     tenant_mobile_config?
  tenant_monitoring_config tenant_monitoring_config?
  trip_attachments         trip_attachments[]
  trip_code_counters       trip_code_counters[]
  trip_command_history     TripCommandHistory[]
  trip_conditions          trip_conditions[]
  trip_deviations          TripDeviation[]
  trip_events              TripEvent[]
  trip_risk_history        TripRiskHistory[]
  trip_risk_levels         TripRiskLevel[]
  trip_sensor_excursions   trip_sensor_excursions[]
  trip_sensor_series       trip_sensor_series[]
  trip_state_history       trip_state_history[]
  trip_summary             trip_summary[]
  trips                    Trip[]
  users                    User[]
  vehicle_geofence_state   vehicle_geofence_state[]
  vehicle_groups           VehicleGroup[]
  vehicles                 Vehicle[]

  @@map("tenants")
}

model NotificationChannel {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenant_id    String   @db.Uuid
  name         String   @db.VarChar(200)
  channel_type String   @db.VarChar(30)
  target       String   @db.VarChar(500)
  events       String[] @default([])
  is_active    Boolean  @default(true)
  config       Json     @default("{}")
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @db.Timestamptz(6)
  tenant       Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@map("notification_channels")
}

model Role {
  id             String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  code           String   @unique @db.VarChar(50)
  name           String   @db.VarChar(100)
  is_system_role Boolean  @default(true)
  permissions    String[] @default([])
  users          User[]

  @@map("roles")
}

model User {
  id                         String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenant_id                  String                 @db.Uuid
  email                      String                 @unique @db.VarChar(254)
  password_hash              String
  full_name                  String?                @db.VarChar(200)
  role_code                  String                 @db.VarChar(50)
  parent_user_id             String?                @db.Uuid
  status                     String                 @default("active") @db.VarChar(20)
  granted_permissions        String[]               @default([])
  revoked_permissions        String[]               @default([])
  entity_restrictions        Json                   @default("{}")
  contact_type               String?                @db.VarChar(30)
  last_login_at              DateTime?              @db.Timestamptz(6)
  created_at                 DateTime               @default(now()) @db.Timestamptz(6)
  control_zones_created      ControlZone[]
  event_logs_acknowledged    EventLog[]
  event_rules_owned          EventRule[]
  geofences_created          Geofence[]
  mobileActivationCodes      MobileActivationCode[]
  no_signal_zones_created    NoSignalZone[]
  parameter_settings_updated ParameterSetting[]
  route_geofences_assigned   RouteGeofence[]
  routes_created             Route[]
  saved_locations_created    SavedLocation[]
  commands_executed          TripCommandHistory[]
  trip_conditions            trip_conditions[]
  trips_created              Trip[]
  accessible_carriers        UserCarrierAccess[]
  accessible_groups          UserGroupAccess[]
  accessible_vehicles        UserVehicleAccess[]
  parent_user                User?                  @relation("UserToUser", fields: [parent_user_id], references: [id])
  child_users                User[]                 @relation("UserToUser")
  role                       Role                   @relation(fields: [role_code], references: [code])
  tenant                     Tenant                 @relation(fields: [tenant_id], references: [id])

  @@map("users")
}

model AvlUser {
  id                    String               @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenant_id             String               @db.Uuid
  user_avl_code         String               @db.VarChar(100)
  name                  String               @db.VarChar(200)
  description           String?
  provider_name         String?              @db.VarChar(200)
  provider_platform_url String?              @db.VarChar(500)
  provider_username     String?
  provider_password     String?
  provider_api_url      String?              @db.VarChar(500)
  provider_api_key      String?
  provider_notes        String?
  api_key               String               @unique @db.VarChar(200)
  is_active             Boolean              @default(true)
  last_data_at          DateTime?            @db.Timestamptz(6)
  created_at            DateTime             @default(now()) @db.Timestamptz(6)
  updated_at            DateTime             @default(now()) @db.Timestamptz(6)
  operational_contact   String?              @db.VarChar(200)
  event_dictionary      AvlEventDictionary[]
  tenant                Tenant               @relation(fields: [tenant_id], references: [id])
  devices               Device[]
  vehicles              Vehicle[]

  @@unique([tenant_id, user_avl_code])
  @@map("avl_users")
}

model AvlEventDictionary {
  id             String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  avl_user_id    String   @db.Uuid
  raw_code       String   @db.VarChar(50)
  event_type     String   @db.VarChar(100)
  description    String?  @db.VarChar(300)
  triggers_alert Boolean  @default(false)
  severity       String   @default("info") @db.VarChar(20)
  is_active      Boolean  @default(true)
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  category       String   @default("event") @db.VarChar(100)
  avl_user       AvlUser  @relation(fields: [avl_user_id], references: [id], onDelete: Cascade)

  @@unique([avl_user_id, category, raw_code])
  @@map("avl_event_dictionary")
}

model Vehicle {
