{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "noFallthroughCasesInSwitch": true
  },
  // `prisma.config.ts` NO es código de la aplicación: lo carga la CLI de
  // Prisma con su propio loader, y usa `import.meta` (ESM), que este tsconfig
  // compila a CommonJS. Incluirlo hacía fallar `tsc --noEmit` con TS1470.
  // La CLI valida el archivo al cargarlo, y `npm run verificar:bloqueo-prisma`
  // comprueba que el bloqueo funciona de verdad.
  "exclude": ["prisma.config.ts", "node_modules", "dist"]
}
