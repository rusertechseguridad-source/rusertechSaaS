# ── Posiciones en vivo ──────────────────────────────────────────────────────
# Origen de datos del mapa en vivo y del tablero de sensores.
#   postgres (default) → consulta directa a `telemetry`. Redis no se toca.
#   redis              → intenta Redis y cae a Postgres ante cualquier problema.
# Postgres es la fuente de verdad: la Mobile API escribe directo a la tabla sin
# pasar por el ingest de NestJS, así que Redis no conoce esos puntos.
# Antes de activar `redis`, leer la nota en live-positions.service.ts.
LIVE_POSITIONS_SOURCE="postgres"

# Ventana temporal de la consulta, en horas (default 24).
# Obligatoria para que Postgres pode particiones de `telemetry`.
LIVE_POSITIONS_WINDOW_HOURS="24"

# REDIS_URL es OPCIONAL. Si se deja vacía, Redis queda deshabilitado y la
# aplicación no intenta conectarse (ni ensucia los logs). Las colas BullMQ sí
# siguen requiriéndolo: ver el reporte de esta tanda.
